# ═══════════════════════════════════════════════════════════════════════════
# PRAHARI · environment
#
# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
# Generate a secret with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# ═══════════════════════════════════════════════════════════════════════════

# ── environment ────────────────────────────────────────────────────────────
# development | test | demo | production
APP_ENV=development
# Generated weather, demo scenarios, seeded accounts. REFUSED when APP_ENV=production.
DEMO_MODE=false
AUTO_SEED_DEMO=false
LOG_LEVEL=INFO
LOG_JSON=false

# ── database ───────────────────────────────────────────────────────────────
# SQLite for local development and the offline demo build.
DATABASE_URL=sqlite:///./var/prahari.db
# PostgreSQL for deployment. APP_ENV=production REFUSES a sqlite:// URL.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/prahari
AUTO_MIGRATE=true

# ── auth ───────────────────────────────────────────────────────────────────
# REQUIRED in production, minimum 32 characters. No default exists.
JWT_SECRET=
ACCESS_TOKEN_HOURS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TTL_MINUTES=30

# ── security ───────────────────────────────────────────────────────────────
# Name the frontend origin. "*" is REFUSED in production.
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=*
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
MAX_UPLOAD_BYTES=12000000

# ── weather ────────────────────────────────────────────────────────────────
# openmeteo | demo | none.  "demo" is generated weather and is REFUSED in production.
# Open-Meteo needs no key. Mahavedh (Maharashtra's ~2,060 automatic weather
# stations) would be the right source at plot level, but its data sits behind
# the WINDS portal and is not openly available to third parties.
# auto = WeatherAPI.com first (when a key is set), then Open-Meteo, then the
# cache. With no key "auto" is exactly Open-Meteo, which is what this project
# ran before, so it is safe to set unconditionally.
WEATHER_PROVIDER=auto

# ── WeatherAPI.com (primary) ───────────────────────────────────────────────
# Get a key at weatherapi.com. Backend only: it is never returned by an
# endpoint, never sent to the browser and must never be committed. On Render
# set it in the dashboard, not in render.yaml.
WEATHER_API_KEY=
# What YOUR PLAN allows. The free tier is a 3-day forecast and ONE day of
# history. PRAHARI's risk board asks for 21 days of past hourly readings, so on
# the free tier WeatherAPI cannot serve that window and the chain falls through
# to Open-Meteo — which is correct, not a failure. Raise these to match a paid
# plan and WeatherAPI becomes primary for the risk window too.
# Getting them WRONG is the one harmful mistake: a provider that claims a
# window it cannot fill returns a short series, and a short series silently
# changes what TOMCAST and the degree-day models compute.
WEATHERAPI_HISTORY_DAYS=1
WEATHERAPI_FORECAST_DAYS=3
# WeatherAPI returns one past day PER REQUEST, so 21 days of history is 21
# requests where Open-Meteo serves the same window in one. This cap is why the
# risk board keeps going to Open-Meteo even on a paid plan. Raise it only if
# you have measured your quota.
WEATHERAPI_MAX_HISTORY_CALLS=10

# ── Open-Meteo (fallback) ──────────────────────────────────────────────────
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# Open-Meteo needs no key; this is only for a commercial subscription. It is a
# separate variable because WEATHER_API_KEY belongs to WeatherAPI.com.
OPEN_METEO_API_KEY=
# Do NOT lower this to chase fresher numbers. The cached object is a 28-day
# hourly window, not a thermometer reading; at 10 minutes the same field costs
# nine times the requests, which is how a rate limit gets self-inflicted in the
# first place. 90 minutes is well inside the resolution of any public model.
WEATHER_CACHE_MINUTES=90
WEATHER_TIMEOUT_SECONDS=8
# After a 429 or a 5xx the provider is left alone for this long, so a rate
# limit clears instead of being held open by retries. Retry-After wins when the
# provider sends one; the cap stops a bad header parking weather for a day.
WEATHER_COOLDOWN_SECONDS=120
WEATHER_COOLDOWN_MAX_SECONDS=900
# How old a cached series may be and still be served, clearly labelled stale,
# when the provider cannot be reached. Past this it is withheld and the screen
# says weather is unavailable. Never a generated substitute.
WEATHER_STALE_MAX_HOURS=12

# ── vision ─────────────────────────────────────────────────────────────────
# onnx | api | none
# With "none", PRAHARI uses its symptom-feature classifier and labels it as
# exactly that everywhere it appears. It is never described as AI.
VISION_PROVIDER=none
VISION_MODEL_PATH=./models/prahari-vision-0.2.onnx
VISION_MODEL_LABELS=./models/labels.json
VISION_MODEL_VERSION=0.2
VISION_API_URL=
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=20
# Set false to disable image diagnosis entirely when no trained model exists;
# the API then answers "AI model unavailable" rather than ranking from features.
ALLOW_FEATURE_ENGINE=true

# ── object storage ─────────────────────────────────────────────────────────
# local | s3   (s3 works with any S3-compatible endpoint: R2, MinIO, B2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./var/uploads
STORAGE_PUBLIC_BASE=/media
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=900

# ── notifications ──────────────────────────────────────────────────────────
# none | log | http.  A delivery is only ever "sent" until a provider callback
# to /api/notifications/webhook/delivery confirms it.
SMS_PROVIDER=none
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=PRAHRI
# none | log | smtp
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── AgriDoc's optional language model ──────────────────────────────────────
# Off by default, and the assistant is fully functional without it: answers are
# assembled from retrieved rows. A key buys FLUENCY, not knowledge — the model
# is handed only what PRAHARI retrieved, and every number it writes is checked
# against those facts before a farmer sees it (see backend/app/llm.py).
#
# Leave these empty for a deployment-wide default of "off". A farmer can supply
# their own key in AgriDoc → the gear icon; theirs takes precedence over this.
LLM_PROVIDER=none          # none | gemini | openai
# NEVER commit a real key. On Render this is set in the dashboard, not here and
# not in render.yaml. It is read server-side only; no key of any kind reaches
# the browser, the bundle or localStorage.
LLM_API_KEY=
# Optional. Unset means the provider default: gemini-2.5-flash, or gpt-4o-mini.
# gemini-2.0-flash is retired — Google has it under previous models, marked for
# shutdown — so do not pin it.
# LLM_MODEL=gemini-2.5-flash
# How long a key is left alone after the provider answers 429 or 5xx. Asking
# again immediately costs the farmer a timeout before they receive the
# retrieved answer they would otherwise have had at once.
LLM_COOLDOWN_SECONDS=300
# Do not lower this. On the Gemini 2.5 models a reasoning pass is billed
# against this cap before any text is produced, so a small value returns an
# empty reply with finishReason MAX_TOKENS and the assistant falls back to the
# template on every question — indistinguishable, from the outside, from a key
# that does not work.
LLM_MAX_OUTPUT_TOKENS=2048

# ── clock ──────────────────────────────────────────────────────────────────
# Pin the date for a bit-for-bit reproducible demo. REFUSED in production.
# PRAHARI_TODAY=2026-08-27

# ── frontend (build time) ──────────────────────────────────────────────────
# Leave empty when the API serves the built frontend from the same origin.
# VITE_API=https://prahari-api.onrender.com
